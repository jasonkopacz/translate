{
  "manifest_version": 3,
  "name": "Smart Translate",
  "version": "1.0",
  "description": "Intelligently translate a percentage of words on web pages using DeepL API",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "background": {
    "service_worker": "static/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["static/js/content.js"]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Smart Translate"
  },
  "icons": {
    "16": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  }
}
