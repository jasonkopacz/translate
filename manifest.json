{
  "manifest_version": 3,
  "name": "Language Translator",
  "version": "1.0",
  "description": "Translate selected words on a page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "dist/popup.js",
    "default_icon": {
      "16": "src/images/translate.png",
      "48": "src/images/translate.png",
      "128": "src/images/translate.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "icons": {
    "16": "src/images/translate.png",
    "48": "src/images/translate.png",
    "128": "src/images/translate.png"
  }
}
